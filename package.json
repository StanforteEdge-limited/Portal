    "build:api": "pnpm --filter portal-api build",
    "deploy:server": "pnpm --filter portal-api deploy:server",
    "tauri:dev": "pnpm --filter stanforte-desktop tauri:dev",
    "tauri:build": "pnpm --filter stanforte-desktop tauri:build"
  },
  "overrides": {
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
