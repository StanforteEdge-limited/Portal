{
  "name": "stanforteedge-portal",
  "private": true,
  "scripts": {
    "dev": "corepack pnpm --filter ./apps/api dev",
    "dev:pwa2": "corepack pnpm --filter stanforte-web dev",
    "dev:web": "corepack pnpm --filter stanforte-web dev",
    "dev:desktop": "corepack pnpm --filter stanforte-desktop dev",
    "dev:api": "corepack pnpm --filter ./apps/api dev",
    "build": "corepack pnpm --filter ./apps/api build",
    "build:pwa2": "corepack pnpm --filter stanforte-web build",
    "build:web": "corepack pnpm --filter stanforte-web build",
    "build:desktop": "corepack pnpm --filter stanforte-desktop build",
    "build:contract": "corepack pnpm --filter @stanforte/contract build",
    "build:api": "corepack pnpm --filter ./apps/api build",
    "deploy:server": "corepack pnpm --filter ./apps/api deploy:server",
    "test": "corepack pnpm --filter ./apps/api test",
    "test:unit": "corepack pnpm --filter ./apps/api test:unit",
    "test:e2e": "corepack pnpm --filter ./apps/api test:e2e",
    "test:playwright": "playwright test",
    "tauri:dev": "corepack pnpm --filter stanforte-desktop tauri:dev",
    "tauri:build": "corepack pnpm --filter stanforte-desktop tauri:build"
  },
  "overrides": {
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "devDependencies": {
    "@playwright/test": "^1.59.1"
  }
}
