# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stanforte?schema=public

# Redis / queues / cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_TTL_SECONDS=300

# Realtime chat (socket.io). Uses the same Redis above for room fan-out across
# instances (adapter + presence). Set REALTIME_ENABLED=false to disable sockets.
REALTIME_ENABLED=true
PRESENCE_ENABLED=true
PRESENCE_TTL_SECONDS=90

# Server
PORT=3000

# JWT
JWT_SECRET=change-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_EXPIRES_IN=30d

# CORS — comma-separated origins allowed to access the API
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limiting
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_RATE_LIMIT_MAX=10        # Max login attempts per window
AUTH_FORGOT_RATE_LIMIT_MAX=5        # Max forgot-password requests per window
AUTH_INVITE_ACCEPT_RATE_LIMIT_MAX=10

# App URLs
APP_BASE_URL=http://localhost:3000
APP_URL=http://localhost:3000

# File serving
FILE_BASE_URL=http://localhost:3000

# Email / SMTP
EMAIL_NOTIFICATIONS_ENABLED=true
EMAIL_TEMPLATES_DIR=                    # optional override for .hbs templates (default: src/common/mail/templates)
MAIL_FROM=no-reply@stanforteedge.com
MAIL_SUPPORT_EMAIL=support@stanforteedge.com
MAIL_LOGO_URL=
MAIL_MESSAGE_ID_DOMAIN=stanforteedge.com
SMTP_HOST=localhost
SMTP_PORT=1025                          # 1025 = Mailpit/Mailhog, 587 = real SMTP
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# PDF generation — path to Chrome executable (required by puppeteer)
PDF_BROWSER_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
PDF_LOGO_PATH=public/branding/logo.png

# File upload limits
FILE_UPLOAD_MAX_MB=10
FILE_UPLOAD_ALLOWED_MIME=application/pdf,image/jpeg,image/png,image/webp,text/plain,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Storage driver — 'local' (default) or 's3'. S3 works with AWS S3 and any
# S3-compatible service (MinIO, DigitalOcean Spaces, Wasabi, Backblaze B2, Cloudflare R2).
STORAGE_DRIVER=local
S3_ENDPOINT=                             # required for MinIO/Spaces/R2, leave empty for AWS S3
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false               # set true for MinIO
S3_PUBLIC_BASE_URL=                     # optional public/CDN base URL if bucket objects are public
# Storage quota: set `storage_gb` on a subscription plan's `limits` jsonb
# (e.g. { "storage_gb": 5 }). Missing or 0 -> unlimited.

# ── Google OAuth (shared credentials for Login + Webmail) ─────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Login OAuth — register this URI under the same Google OAuth client
GOOGLE_AUTH_REDIRECT_URI=http://localhost:3000/v1/auth/google/callback
# Webmail OAuth — full Gmail IMAP/SMTP access
GOOGLE_REDIRECT_URI=http://localhost:3000/v1/mail/auth/google/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:3000/v1/mail/auth/microsoft/callback
MAIL_ENCRYPTION_KEY=generate-with-node-e-crypto-randombytes-32-hex

# Billing / Paystack
PAYSTACK_SECRET_KEY=
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_SCHEDULER_ENABLED=true
