{
  "compilerOptions": {
    "target": "ES2021",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "baseUrl": "src",
    "paths": {
      "$app/*": ["./*"],
      "$apps/*": ["apps/*"],
      "$core/*": ["core/*"],
      "$plugins/*": ["plugins/*"],
      "$config/*": ["config/*"]
    },
    "outDir": "dist",
    "rootDir": "src",
    "strict": false,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false,
    "strictPropertyInitialization": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/__tests__/**"]
}
