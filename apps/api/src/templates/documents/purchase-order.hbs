<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <style>
    body { font-family: Arial, sans-serif; font-size: 12px; color: #111827; }
    table { width: 100%; border-collapse: collapse; margin-top: 16px; }
    th, td { border: 1px solid #d1d5db; padding: 6px 10px; }
    th { background: #f3f4f6; text-align: left; }
    .header { display: flex; justify-content: space-between; margin-bottom: 24px; }
    .label { color: #6b7280; font-size: 11px; text-transform: uppercase; letter-spacing: .02em; }
    .total { font-weight: bold; text-align: right; margin-top: 8px; }
    .meta { display: flex; gap: 40px; margin-bottom: 16px; }
  </style>
</head>
<body>
  <div class="header">
    <div><strong>{{orgName}}</strong><br />{{orgAddress}}</div>
    <div style="text-align:right">
      <h2 style="margin:0">PURCHASE ORDER</h2>
      <div>{{poNumber}}</div>
      <div class="label">Date: {{date}}</div>
    </div>
  </div>

  <div style="margin-bottom:16px">
    <div class="label">Vendor</div>
    <div><strong>{{vendor.name}}</strong></div>
    {{#if vendor.address}}<div>{{vendor.address}}</div>{{/if}}
    {{#if vendor.email}}<div>{{vendor.email}}</div>{{/if}}
  </div>

  <div class="meta">
    <div><span class="label">Delivery Address</span><br />{{deliveryAddress}}</div>
    <div><span class="label">Expected Delivery</span><br />{{deliveryDate}}</div>
    <div><span class="label">Payment Terms</span><br />{{paymentTerms}}</div>
    <div><span class="label">Payment Pattern</span><br />{{paymentPattern}}</div>
  </div>

  <table>
    <thead>
      <tr>
        <th>Description</th>
        <th style="text-align:center">Qty</th>
        <th style="text-align:center">Unit</th>
        <th style="text-align:right">Unit Cost</th>
        <th style="text-align:right">Total</th>
      </tr>
    </thead>
    <tbody>
      {{#each items}}
        <tr>
          <td>{{description}}</td>
          <td style="text-align:center">{{qty}}</td>
          <td style="text-align:center">{{unit}}</td>
          <td style="text-align:right">{{unitCostLabel}}</td>
          <td style="text-align:right">{{totalCostLabel}}</td>
        </tr>
      {{/each}}
    </tbody>
  </table>

  <div class="total">Total: {{totalAmountLabel}}</div>
  <div style="margin-top:40px">
    <div class="label">Prepared by</div>
    <div>{{preparedBy}}</div>
  </div>
</body>
</html>
