<p style="margin:0 0 16px; font-size:16px; font-weight:600; color:#111827; line-height:1.5;">{{title}}</p>
<p style="margin:0 0 20px; font-size:14px; color:#4b5563; line-height:1.6;">{{message}}</p>
{{#if portalUrl}}
<p style="margin:0 0 20px;">
  <a href="{{portalUrl}}" style="display:inline-block; background:#ff6900; color:#ffffff; text-decoration:none; font-weight:600; font-size:14px; padding:10px 24px; border-radius:8px;">
    {{#if ctaLabel}}{{ctaLabel}}{{else}}View in Portal{{/if}}
  </a>
</p>
<p style="margin:0 0 8px; font-size:12px; color:#64748b;">If the button doesn't work, copy and paste this link into your browser:</p>
<p style="margin:0 0 16px; font-size:12px; color:#0f172a; word-break:break-all;"><a href="{{portalUrl}}" style="color:#ff6900;">{{portalUrl}}</a></p>
{{/if}}
<p style="margin:20px 0 0 0; font-size:12px; color:#94a3b8; border-top:1px solid #f1f5f9; padding-top:12px;">
  You received this email notification because you were tagged or mentioned while offline.
</p>
