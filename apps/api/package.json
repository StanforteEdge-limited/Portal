{
  "name": "portal-api-fastify",
  "version": "0.1.0",
  "private": true,
  "description": "StanforteEdge Portal API Fastify port",
  "scripts": {
    "dev": "tsx watch -r ./path-alias-register.cjs src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node -r ./path-alias-register.cjs dist/server.js",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:migrate": "drizzle-kit migrate",
    "drizzle:migrate:locked": "node scripts/migrate-locked.cjs",
    "drizzle:push": "drizzle-kit push",
    "drizzle:studio": "drizzle-kit studio",
    "scaffold:apps": "node scripts/scaffold-app-files.cjs",
    "migrate:db-schema": "node scripts/migrate-db-schema.cjs",
    "migrate:schemas": "node scripts/migrate-schemas.cjs",
    "migrate:services": "node scripts/migrate-services.cjs",
    "normalize:services": "node scripts/normalize-service-files.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.782.0",
    "@aws-sdk/s3-request-presigner": "^3.782.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/redis": "9.0.0",
    "@sinclair/typebox": "^0.34.33",
    "@stanforte/contract": "workspace:*",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.3.4",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.3.1",
    "drizzle-orm": "1.0.0-rc.4",
    "fastify": "^5.0.0",
    "fastify-plugin": "6.0.0",
    "googleapis": "^173.0.0",
    "handlebars": "^4.7.9",
    "imapflow": "^1.4.6",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "mailparser": "^3.9.14",
    "nodemailer": "^8.0.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "puppeteer": "^24.37.4",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20.11.30",
    "@types/nodemailer": "^6.4.15",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "1.0.0-rc.4",
    "tsx": "^4.23.13",
    "typescript": "^5.4.3"
  }
}
