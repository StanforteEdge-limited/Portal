{
  "name": "portal-api",
  "version": "0.1.1",
  "private": true,
  "description": "StanforteEdge Portal API (NestJS + Postgres)",
  "scripts": {
    "dev": "ts-node-dev -r ./path-alias-register.js --respawn --transpile-only src/main.ts",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 tsc -p tsconfig.build.json && node scripts/copy-email-templates.js",
    "start": "node -r ./path-alias-register.js dist/main.js",
    "prepare:runtime": "drizzle-kit migrate && npm run seed:version",
    "deploy:server": "npm run prepare:runtime && npm run build",
    "db:seed": "node scripts/seed-rbac.js",
    "seed:rbac": "node scripts/seed-rbac.js",
    "seed:version": "node scripts/seed-version.js",
    "seed:first-user": "node scripts/seed-first-user.js",
    "seed:finance-requests": "node scripts/seed-finance-requests.js",
    "seed:procurement-requests": "node scripts/seed-procurement-requests.js",
    "seed:documents": "node scripts/seed-documents.js",
    "seed:hr-onboarding-forms": "node scripts/seed-hr-onboarding.js",
    "seed:hr-leave-system": "node scripts/seed-hr-leave-system.js",
    "seed:release-baseline": "node scripts/seed-release-baseline.js",
    "seed:request-categories": "node scripts/seed-request-categories.js",
    "seed:procurement-request-types": "node scripts/seed-procurement-request-types.js",
    "seed:procurement-categories": "node scripts/seed-procurement-categories.js",
    "seed:loans-system": "node scripts/seed-loans-system.js",
    "seed:grant-all-roles": "node scripts/grant-all-roles.js",
    "repair:request-workflows": "node scripts/repair-request-workflow-links.js",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:migrate": "drizzle-kit migrate",
    "drizzle:push": "drizzle-kit push",
    "drizzle:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.782.0",
    "@aws-sdk/s3-request-presigner": "^3.782.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/cache-manager": "^12.0.0",
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.2",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/platform-socket.io": "^10.3.0",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/websockets": "^10.3.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/nodemailer": "^7.0.10",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.3.4",
    "cache-manager": "^7.2.9",
    "cache-manager-ioredis-yet": "^2.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.3.1",
    "drizzle-orm": "1.0.0-rc.4",
    "express": "^4.19.2",
    "express-rate-limit": "^8.2.1",
    "googleapis": "^173.0.0",
    "handlebars": "^4.7.9",
    "imapflow": "^1.4.6",
    "ioredis": "^6.0.0",
    "jszip": "^3.10.1",
    "mailparser": "^3.9.14",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "puppeteer": "^24.37.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cache-manager": "^5.0.0",
    "@types/express": "^4.17.21",
    "@types/mailparser": "^3.4.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.11.30",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "1.0.0-rc.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.4.3"
  }
}
